{
  "name": "git-graph-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Git history explorer for Windows, built with Tauri and React",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "pnpm test:ui && pnpm test:rust",
    "test:ui": "node --test test/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "package:win": "tauri build --bundles nsis",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  }
}
